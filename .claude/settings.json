{
  "env": {
    "ANTHROPIC_BASE_URL": "https://adesso-ai-hub.3asabc.de"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__Storyblok__.*|mcp__plugin_storyblok_storyblok__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-storyblok-space.mjs\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "storyblok@storyblok": true
  },
  "modelPicker": {
    "options": [
      {
        "model": "claude-sonnet-5",
        "label": "Claude Sonnet 5 (AI Hub)",
        "description": "Claude Sonnet 5 from adesso AI-Hub",
        "behavesAs": "claude-sonnet-5"
      },
      {
        "model": "gemini-3.8-flash",
        "label": "Gemini 3.8 Flash",
        "description": "Gemini 3.8 Flash from adesso AI-Hub",
        "behavesAs": "claude-sonnet-5"
      },
      {
        "model": "deepseek-v4-flash-sovereign",
        "label": "DeepSeek V4 Flash Sovereign",
        "description": "DeepSeek V4 Flash Sovereign from adesso AI-Hub",
        "behavesAs": "claude-haiku-4-5"
      }
    ]
  }
}